{
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash deployment/build-frontend-vercel.sh",
  "outputDirectory": "frontend/build/web",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
  }]
}
