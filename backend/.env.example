OPENAI_API_KEY=sk-your-key
FAL_KEY=your-fal-key
OPENWEATHER_API_KEY=
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.5
FAL_FASHN_MODE=quality
FAL_GARMENT_PHOTO_TYPE=auto
FAL_FASHN_MODERATION_LEVEL=permissive
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CLOSET_RECOMMENDATION_MODEL=gpt-5.4-mini
CLOSET_RECOMMENDATION_AI_ENABLED=false
# product_catalog uses collected real products; prices and stock are not live.
SHOPPING_PROVIDER=product_catalog
# Enable before exposing this backend to the internet. Public Firebase project key.
REQUIRE_FIREBASE_AUTH=false
FIREBASE_API_KEY=
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_PERSIST_DIR=/absolute/path/to/backend/data/chroma
CHROMA_COLLECTION=kfashion_style_items
MOCK_MODE=true
CORS_ORIGINS=*
